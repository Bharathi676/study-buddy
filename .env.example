# Study Buddy Configuration

# ==========================================
# 1. Gemini API Key (Server-side)
# Get your key at: https://aistudio.google.com/app/apikey
# ==========================================
GEMINI_API_KEY=your_gemini_api_key_here

# Backend Server Port (defaults to 5000)
PORT=5000

# ==========================================
# 2. Firebase Web App Configuration (Client-side)
# Get these in Firebase Console:
# https://console.firebase.google.com/ -> Project Settings -> General -> Your Apps -> Web App
# Also enable Authentication (Email/Password & Google) and Firestore Database in Firebase Console
# ==========================================
VITE_FIREBASE_API_KEY=AIzaSyDummyKey_ReplaceWithYourActualKey
VITE_FIREBASE_AUTH_DOMAIN=study-buddy-demo.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=study-buddy-demo
VITE_FIREBASE_STORAGE_BUCKET=study-buddy-demo.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
